AI_API_KEY=replace-with-your-deepseek-api-key
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash

# DeepSeek chat does not provide an embedding endpoint. Configure a separate
# OpenAI-compatible embedding provider when real semantic vectors are required.
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Docker Compose exposes MySQL on 13307 and pgvector on 5432.
MYSQL_URL=jdbc:mysql://localhost:13307/recruit_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/recruit_vector
VECTOR_DB_USERNAME=recruit
VECTOR_DB_PASSWORD=recruit

# The default IDEA working directory is the repository root.
LOCAL_STORAGE_ROOT=recruit-start/data/resumes

JWT_REFRESH_EXPIRES_IN_SECONDS=604800
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_MIN_SCORE=35

# Lucene BM25 sparse retrieval and deterministic second-stage reranking.
BM25_K1=1.2
BM25_B=0.75
RERANKER_MODE=heuristic
RERANKER_RRF_WEIGHT=0.35
RERANKER_DENSE_WEIGHT=0.20
RERANKER_SPARSE_WEIGHT=0.20
RERANKER_CONTENT_WEIGHT=0.20
RERANKER_SOURCE_WEIGHT=0.05
